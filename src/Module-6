
import java.util.*;
import java.util.function.*;
import java.util.stream.Collectors;

public class Module6_CollectionsStreams {
    public static void main(String[] args) {

        // Collections: List, Set and Map
        List<Double> amounts = new ArrayList<>(
            List.of(500.0, 100.0, 500.0, 1200.0, 250.0)
        );

        Set<Double> uniqueAmounts =
            new LinkedHashSet<>(amounts);

        Map<String, Double> totals = new HashMap<>();
        totals.put("Deposit", 1700.0);
        totals.put("Withdrawal", 350.0);

        System.out.println("List: " + amounts);
        System.out.println("Unique amounts: " + uniqueAmounts);
        System.out.println("Transaction totals: " + totals);

        // Functional interfaces
        Predicate<Double> isLarge = amount -> amount >= 250;
        Function<Double, String> format =
            amount -> "₹" + amount;
        Consumer<String> printer = System.out::println;
        Supplier<Double> defaultBalance = () -> 1000.0;

        System.out.println("Large transactions:");
        amounts.stream()
                .filter(isLarge)
                .map(format)
                .forEach(printer);

        System.out.println(
            "Default balance: ₹" + defaultBalance.get()
        );

        // filter, distinct, sorted, limit and collect
        List<Double> filteredAmounts = amounts.stream()
                .filter(amount -> amount >= 250)
                .distinct()
                .sorted()
                .limit(3)
                .collect(Collectors.toList());

        System.out.println(
            "Filtered amounts: " + filteredAmounts
        );

        // count
        long count = amounts.stream()
                .filter(amount -> amount >= 250)
                .count();
        System.out.println("Count >= ₹250: " + count);

        // reduce
        double sum = amounts.stream()
                .reduce(0.0, Double::sum);
        System.out.println("Total amount: ₹" + sum);

        // joining collector
        String joined = amounts.stream()
                .map(String::valueOf)
                .collect(Collectors.joining(" | "));
        System.out.println("All amounts: " + joined);

        // groupingBy and counting
        List<String> types = List.of(
            "Deposit", "Withdrawal",
            "Deposit", "Deposit", "Withdrawal"
        );

        Map<String, Long> counts = types.stream()
                .collect(Collectors.groupingBy(
                    type -> type,
                    Collectors.counting()
                ));

        System.out.println("Transaction type counts: " + counts);

        // Lambda expression
        types.forEach(type ->
            System.out.println("Transaction type: " + type)
        );

        // Method reference
        System.out.println("All transaction types:");
        types.forEach(System.out::println);
    }
}
